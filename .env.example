# ============================================================
# MintPrompt — Environment Variables Example
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to git.
# ============================================================

# ─── Supabase (required for production) ─────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-side only — used in API routes & admin dashboard
# (Service Role key has full DB access — keep it SECRET)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── App Config ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MintPrompt

# ─── Affiliate / Redirect ───────────────────────────────────
NEXT_PUBLIC_AFFILIATE_REDIRECT_URL=https://example.com
NEXT_PUBLIC_AFFILIATE_COOLDOWN_MS=3600000

# ─── Analytics (optional) ───────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
